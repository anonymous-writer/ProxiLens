[Unit]
Description=ProxiLens per-user development grant broker
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/proxilens-ui --grant-broker
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t/proxilens

[Install]
WantedBy=default.target
