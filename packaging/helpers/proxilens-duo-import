#!/usr/bin/env python3
"""Root-only importer. Receives credential JSON on stdin; never logs secrets."""
import json, os, pwd, re, sys, tempfile, subprocess

if os.geteuid() != 0:
    print("Dieser Helfer muss über pkexec als root laufen.", file=sys.stderr)
    sys.exit(1)
raw = sys.stdin.buffer.read(16385)
if not raw or len(raw) > 16384:
    print("Ungültige oder zu große Eingabe.", file=sys.stderr)
    sys.exit(2)
try:
    d = json.loads(raw)
except Exception:
    print("Ungültige Konfigurationsdaten.", file=sys.stderr)
    sys.exit(2)
fields = {k: str(d.get(k, "")).strip() for k in ("ikey", "skey", "host", "username", "push_type")}
try:
    # pkexec supplies the invoking desktop user's numeric UID. Bind the
    # broker config to that local account; never trust a username from JSON.
    invoking_uid = int(os.environ["PKEXEC_UID"])
    local_username = pwd.getpwuid(invoking_uid).pw_name
except (KeyError, ValueError):
    print("Aufrufender lokaler Benutzer konnte nicht ermittelt werden.", file=sys.stderr)
    sys.exit(2)
if invoking_uid == 0 or not local_username:
    print("Ungültiger aufrufender Benutzer.", file=sys.stderr)
    sys.exit(2)
if not all(fields[k] for k in ("ikey", "skey", "host", "username")):
    print("Duo-Konfiguration unvollständig.", file=sys.stderr)
    sys.exit(2)
if re.search(r"[\s/:?#@]", fields["host"]) or "://" in fields["host"]:
    print("Ungültiger Duo-API-Hostname.", file=sys.stderr)
    sys.exit(2)
for k, v in fields.items():
    if "\n" in v or "\r" in v or "\x00" in v:
        print("Ungültige Zeichen in Konfiguration.", file=sys.stderr)
        sys.exit(2)
os.makedirs("/etc/proxilens", mode=0o700, exist_ok=True)
os.chown("/etc/proxilens", 0, 0)
os.chmod("/etc/proxilens", 0o700)
fd, tmp = tempfile.mkstemp(prefix="duo.conf.", dir="/etc/proxilens")
try:
    os.fchmod(fd, 0o600)
    os.fchown(fd, 0, 0)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("[duo]\n")
        for k in ("ikey", "skey", "host", "username", "push_type"):
            if fields[k]: f.write(f"{k}={fields[k]}\n")
        f.write(f"local_username={local_username}\n")
        f.flush(); os.fsync(f.fileno())
    os.replace(tmp, "/etc/proxilens/duo.conf")
    os.chown("/etc/proxilens/duo.conf", 0, 0)
    os.chmod("/etc/proxilens/duo.conf", 0o600)
finally:
    try: os.unlink(tmp)
    except FileNotFoundError: pass
# Start the packaged broker only after the protected configuration exists.
try:
    subprocess.run(["systemctl", "daemon-reload"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    subprocess.run(["systemctl", "enable", "--now", "proxilens-policy.service"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
except (OSError, subprocess.CalledProcessError) as exc:
    print("Duo-Konfiguration wurde gespeichert, aber der Policy-Dienst konnte nicht gestartet werden.", file=sys.stderr)
    if isinstance(exc, subprocess.CalledProcessError) and exc.stderr:
        print(exc.stderr.decode("utf-8", "replace").strip(), file=sys.stderr)
    sys.exit(3)
print("Root-Dienst-Konfiguration aktualisiert und Policy-Dienst gestartet. Zugangsdaten wurden nicht ausgegeben.")
